# FairFix.ie — Environment Variables Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, set these in the Cloudflare Pages dashboard:
#   Settings -> Environment variables

# --- Public (safe to expose in browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=FairFix.ie

# --- Anthropic (AI price estimation) ---
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Cloudflare KV / D1 binding names ---
# These match the bindings configured in the Cloudflare Pages dashboard.
# The waitlist API writes emails into the KV namespace bound as WAITLIST.
WAITLIST_KV_BINDING=WAITLIST

# --- Email (waitlist confirmations, later) ---
# Sign up at https://resend.com/ for a free tier
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@fairfix.ie

# --- Database (Supabase — added in Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

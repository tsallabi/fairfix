# FairFix.ie — Environment Variables Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, set these in the Cloudflare Pages dashboard:
#   Settings -> Environment variables

# ─── Public (safe to expose in browser) ─────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=FairFix.ie

# ─── Anthropic (AI price estimation — REQUIRED for /estimate) ───────
# Sign up at https://console.anthropic.com/ and create a key.
# In Cloudflare Pages -> Settings -> Environment variables (Production),
# add ANTHROPIC_API_KEY as an ENCRYPTED variable.
# The /api/estimate route falls back to a market-typical range when
# this key is missing, so the UI keeps working without it.
ANTHROPIC_API_KEY=

# ─── Cloudflare bindings ────────────────────────────────────────────
# These names must match the bindings configured in the Cloudflare Pages
# dashboard (Settings -> Functions).
#   KV binding:  WAITLIST     (namespace: fairfix-waitlist)
#   D1 binding:  DB           (database: fairfix-db)

# ─── Email (waitlist confirmations — Phase 2B) ──────────────────────
# Sign up at https://resend.com/ for a free tier.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@fairfix.ie

# ─── Optional: Supabase (Phase 3 auth if we switch off D1) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
